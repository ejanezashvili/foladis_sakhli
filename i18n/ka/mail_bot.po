#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of human language...%(new_line)sI can show you features if you write: %(command_start)sstart the tour%(command_end)s."
msgstr "ბოდიში, მეძინება. ან არა! იქნებ უბრალოდ ვცდილობ დავმალო, რომ ადამიანის ენა არ მესმის...%(new_line)sშესაძლებლობებს გაჩვენებთ, თუ დაწერთ: %(command_start)sტურის დაწყება%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Sorry, I am not listening. To get someone's attention, %(bold_start)sping him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select me."
msgstr "ბოდიში, არ გისმენთ. ვინმეს ყურადღების მისაპყრობად %(bold_start)sმონიშნეთ ის%(bold_end)s. დაწერეთ %(command_start)s@OdooBot%(command_end)s და ამირჩიეთ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "მადლობა"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "მადლობა გამოხმაურებისთვის. ნახვამდის!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "ეს არ არის ლამაზი! ბოტი ვარ, მაგრამ გრძნობები მაქვს... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That’s the end of this overview. You can %(bold_start)sclose this conversation%(bold_end)s or type %(command_start)sstart the tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr "ამით გაცნობა დასრულდა. შეგიძლიათ %(bold_start)sდახუროთ ეს საუბარი%(bold_end)s ან აკრიფოთ %(command_start)sტურის დაწყება%(command_end)s მის თავიდან სანახავად. წარმატებებს გისურვებთ Odoo-ს შესწავლაში!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "This is a temporary canned response to see how canned responses work."
msgstr "ეს არის დროებითი შაბლონური პასუხი, რომ ნახოთ, როგორ მუშაობს შაბლონური პასუხები."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To %(bold_start)ssend an attachment%(bold_end)s, click on the %(paperclip_icon)s icon and select a file."
msgstr "%(bold_start)sფაილის გასაგზავნად%(bold_end)s დააწკაპუნეთ %(paperclip_icon)s ხატულაზე და აირჩიეთ ფაილი."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To start, try to send me an emoji :)"
msgstr "დასაწყისისთვის, სცადეთ ემოჯის გამოგზავნა :)"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Try to send me an emoji"
msgstr "სცადეთ ემოჯის გამოგზავნა"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Unfortunately, I'm just a bot 😞 I don't understand! If you need help discovering our product, please check %(document_link_start)sour documentation%(document_link_end)s or %(slides_link_start)sour videos%(slides_link_end)s."
msgstr "სამწუხაროდ, მხოლოდ ბოტი ვარ 😞 ვერ გავიგე! თუ პროდუქტის გაცნობაში დახმარება გჭირდებათ, ნახეთ %(document_link_start)sჩვენი დოკუმენტაცია%(document_link_end)s ან %(slides_link_start)sჩვენი ვიდეოები%(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "მომხმარებელი"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to use canned responses. I've created a temporary one for you."
msgstr "შესანიშნავია! 😇%(new_line)sშაბლონური პასუხების გამოსაყენებლად სცადეთ %(command_start)s::%(command_end)s-ის აკრეფა. თქვენთვის დროებითი პასუხი შევქმენი."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Wow you are a natural!%(new_line)sPing someone with @username to grab their attention. %(bold_start)sTry to ping me using%(bold_end)s %(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr "ბუნებით ნიჭიერი ხართ!%(new_line)sვინმეს ყურადღების მისაპყრობად მონიშნეთ @username-ით. %(bold_start)sსცადეთ ჩემი მონიშვნა%(bold_end)s %(command_start)s@OdooBot%(command_end)s-ით წინადადებაში."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an attachment%(bold_end)s, like a picture of your cute dog..."
msgstr "დიახ, აქ ვარ! 🎉 %(new_line)sახლა სცადეთ %(bold_start)sფაილის გაგზავნა%(bold_end)s, მაგალითად, თქვენი საყვარელი ძაღლის ფოტო..."


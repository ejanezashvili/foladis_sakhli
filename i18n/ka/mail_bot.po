#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Aaaaaw that's really cute but, you know, bots don't work that way. You're too human for me! Let's keep it professional ❤️"
msgstr "ოჰ, ეს მართლაც საყვარელია, მაგრამ იცით, ბოტები ასე არ მუშაობენ. ჩემთვის ზედმეტად ადამიანი ხართ! მოდით, პროფესიონალურად ვისაუბროთ ❤️"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "გამორთული"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "სადისკუსიო არხი"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Great! You can customize %(bold_start)scanned responses%(bold_end)s in the Discuss app."
msgstr "შესანიშნავია! %(bold_start)sშაბლონური პასუხების%(bold_end)s მორგება შეგიძლიათ დისკუსიის აპლიკაციაში."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting help."
msgstr "შესანიშნავია! 👍%(new_line)sსპეციალური ბრძანებების გამოსაყენებლად %(bold_start)sდაიწყეთ წინადადება%(bold_end)s %(command_start)s/%(command_end)s-ით. სცადეთ დახმარების მიღება."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello,"
msgstr "გამარჯობა,"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "ჰმმ..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "ვწუხვარ, ვერ გავიგე!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm not smart enough to answer your question.%(new_line)sTo follow my guide, ask: %(command_start)sstart the tour%(command_end)s."
msgstr "თქვენს კითხვაზე პასუხის გასაცემად საკმარისად ჭკვიანი არ ვარ.%(new_line)sჩემი გზამკვლევის გასავლელად დაწერეთ: %(command_start)sტურის დაწყება%(command_end)s."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "უმოქმედო"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "ფოსტის ბოტი"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Not exactly. To continue the tour, send an emoji: %(bold_start)stype%(bold_end)s%(command_start)s :)%(command_end)s and press enter."
msgstr "არა ზუსტად. ტურის გასაგრძელებლად გამოგზავნეთ ემოჯი: %(bold_start)sაკრიფეთ%(bold_end)s%(command_start)s :)%(command_end)s და დააჭირეთ Enter-ს."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "არ არის ინიციალიზებული"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Not sure what you are doing. Please, type %(command_start)s/%(command_end)s and wait for the propositions. Select %(command_start)shelp%(command_end)s and press enter."
msgstr "ვერ ვხვდები, რას აკეთებთ. გთხოვთ, აკრიფოთ %(command_start)s/%(command_end)s და დაელოდოთ შემოთავაზებებს. აირჩიეთ %(command_start)shelp%(command_end)s და დააჭირეთ Enter-ს."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Not sure what you are doing. Please, type %(command_start)s:%(command_end)s and wait for the propositions. Select one of them and press enter."
msgstr "ვერ ვხვდები, რას აკეთებთ. გთხოვთ, აკრიფოთ %(command_start)s:%(command_end)s და დაელოდოთ შემოთავაზებებს. აირჩიეთ ერთ-ერთი და დააჭირეთ Enter-ს."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Odoo's chat helps employees collaborate efficiently. I'm here to help you discover its features."
msgstr "Odoo-ს ჩატი თანამშრომლებს ეფექტიან თანამშრომლობაში ეხმარება. მე აქ ვარ, რომ მისი შესაძლებლობები გაგაცნოთ."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "OdooBot-ის სტატუსი"


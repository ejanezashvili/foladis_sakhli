#: code:addons/base/models/res_users.py:0
msgid "You can not remove the admin user as it is used internally for resources created by Odoo (updates, module installation, ...)"
msgstr "ადმინისტრატორის მომხმარებლის წაშლა შეუძლებელია, რადგან ის შიდა მიზნებისთვის გამოიყენება Odoo-ს მიერ შექმნილი რესურსებისთვის (განახლებები, მოდულების ინსტალაცია, ...)"

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You can ony call user.has_group() with your current user."
msgstr "user.has_group()-ის გამოძახება შესაძლებელია მხოლოდ მიმდინარე მომხმარებლით."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot activate the superuser."
msgstr "სუპერმომხმარებლის გააქტიურება შეუძლებელია."

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot archive contacts linked to an active user.\n"
"Ask an administrator to archive their associated user first.\n"
"\n"
"Linked active users :\n"
"%(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების დაარქივება შეუძლებელია.\n"
"სთხოვეთ ადმინისტრატორს, ჯერ მათთან დაკავშირებული მომხმარებელი დააარქივოს.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები:\n"
"%(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot archive contacts linked to an active user.\n"
"You first need to archive their associated user.\n"
"\n"
"Linked active users : %(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების დაარქივება შეუძლებელია.\n"
"ჯერ უნდა დააარქივოთ მათთან დაკავშირებული მომხმარებელი.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები: %(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid "You cannot create recursive Partner hierarchies."
msgstr "კონტაქტების რეკურსიული იერარქიის შექმნა შეუძლებელია."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot deactivate the user you're currently logged in as."
msgstr "იმ მომხმარებლის დეაქტივაცია, რომლითაც ამჟამად ხართ შესული, შეუძლებელია."

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot delete contacts linked to an active user.\n"
"Ask an administrator to archive their associated user first.\n"
"\n"
"Linked active users :\n"
"%(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების წაშლა შეუძლებელია.\n"
"სთხოვეთ ადმინისტრატორს, ჯერ მათთან დაკავშირებული მომხმარებელი დააარქივოს.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები:\n"
"%(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot delete contacts linked to an active user.\n"
"You should rather archive them after archiving their associated user.\n"
"\n"
"Linked active users : %(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების წაშლა შეუძლებელია.\n"
"ამის ნაცვლად, ჯერ დააარქივეთ დაკავშირებული მომხმარებელი, შემდეგ კი თავად კონტაქტები.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები: %(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot delete the admin user because it is utilized in various places (such as security configurations,...). Instead, archive it."
msgstr "ადმინისტრატორის მომხმარებლის წაშლა შეუძლებელია, რადგან ის სისტემის სხვადასხვა ადგილას გამოიყენება (მაგ., უსაფრთხოების პარამეტრებში,...). ამის ნაცვლად, დააარქივეთ."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot exceed %(duration)s days."
msgstr "%(duration)s დღეზე მეტის მითითება შეუძლებელია."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You must have at least an administrator user."
msgstr "სისტემაში უნდა იყოს მინიმუმ ერთი ადმინისტრატორი მომხმარებელი."

#. module: base
#: model_terms:ir.ui.view,arch_db:base.view_users_simple_form
msgid "You will be able to define additional access rights by editing the newly created user under the Settings / Users menu."
msgstr "დამატებითი წვდომის უფლებების განსაზღვრა შეგეძლებათ ახლად შექმნილი მომხმარებლის რედაქტირებით, მენიუში პარამეტრები / მომხმარებლები."


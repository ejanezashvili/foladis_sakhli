<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- task form: the HR process block (only on an HR request, not on its sub-tasks) -->
    <record id="view_project_task_form_sh_hr_process" model="ir.ui.view">
        <field name="name">project.task.form.sh.hr.process</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sh_hr_kind" invisible="1"/>
                <field name="sh_hr_is_manager" invisible="1"/>
                <field name="sh_hr_is_director" invisible="1"/>
                <field name="sh_hr_required_fnames" invisible="1"/>
                <button name="action_sh_hr_send" type="object" string="დირექტორს გაგზავნა" class="btn-primary"
                        invisible="not sh_hr_kind or parent_id or sh_hr_state != 'new' or not sh_hr_is_manager"/>
                <button name="action_sh_hr_approve" type="object" string="დამტკიცება" class="btn-success"
                        invisible="not sh_hr_kind or sh_hr_state != 'director' or not sh_hr_is_director"/>
                <button name="action_sh_hr_refuse" type="object" string="უარყოფა" class="btn-danger"
                        invisible="not sh_hr_kind or sh_hr_state != 'director' or not sh_hr_is_director"/>
                <button name="action_sh_hr_payment" type="object" string="გადახდაში"
                        invisible="sh_hr_kind != 'vacancy' or sh_hr_state != 'approved' or not sh_hr_is_manager"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('justify-content-between')][1]" position="after">
                <div class="o_sh_hr_block mb-3" invisible="not sh_hr_kind or parent_id">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge text-bg-primary fs-6"><field name="sh_hr_kind" readonly="1" nolabel="1"/></span>
                        <span class="text-muted ms-2" invisible="not sh_hr_author_id">მომთხოვნი: <field name="sh_hr_author_id" readonly="1" nolabel="1" class="d-inline"/></span>
                        <field name="sh_hr_state" widget="statusbar" readonly="1"
                               statusbar_visible="new,director,approved,done"/>
                    </div>
                    <div class="alert alert-warning py-2 mb-2" role="alert"
                         invisible="sh_hr_state not in ('new', 'director') or not sh_hr_missing">
                        შესავსებია: <field name="sh_hr_missing" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-danger py-2 mb-2" role="alert" invisible="sh_hr_state != 'refused'">
                        უარყოფის მიზეზი: <field name="sh_hr_refuse_reason" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <group invisible="sh_hr_kind != 'vacancy'" string="ვაკანსია">
                        <group>
                            <field name="sh_hr_position" required="not parent_id and ',sh_hr_position,' in (sh_hr_required_fnames or '')" string="თანამდებობის დასახელება"/>
                            <field name="sh_hr_workplace" required="not parent_id and ',sh_hr_workplace,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_schedule" required="not parent_id and ',sh_hr_schedule,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_salary" required="not parent_id and ',sh_hr_salary,' in (sh_hr_required_fnames or '')"/>
                        </group>
                        <group>
                            <field name="sh_hr_duties" required="not parent_id and ',sh_hr_duties,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_requirements" required="not parent_id and ',sh_hr_requirements,' in (sh_hr_required_fnames or '')"/>
                        </group>
                    </group>
                    <group invisible="sh_hr_kind != 'hire'" string="ახალი თანამშრომელი">
                        <group>
                            <field name="sh_hr_id_number" required="not parent_id and ',sh_hr_id_number,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_phone" required="not parent_id and ',sh_hr_phone,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_address" required="not parent_id and ',sh_hr_address,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_bank_account" required="not parent_id and ',sh_hr_bank_account,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_email" required="not parent_id and ',sh_hr_email,' in (sh_hr_required_fnames or '')"/>
                        </group>
                        <group>
                            <field name="sh_hr_position" required="not parent_id and ',sh_hr_position,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_salary" required="not parent_id and ',sh_hr_salary,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_schedule" required="not parent_id and ',sh_hr_schedule,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_start_date" required="not parent_id and ',sh_hr_start_date,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_legal_entity_id" required="not parent_id and ',sh_hr_legal_entity_id,' in (sh_hr_required_fnames or '')" options="{'no_create': True}"/>
                            <field name="sh_hr_org_code"/>
                        </group>
                    </group>
                    <group invisible="sh_hr_kind != 'dismissal'" string="გათავისუფლება">
                        <group>
                            <field name="sh_hr_application" required="not parent_id and ',sh_hr_application,' in (sh_hr_required_fnames or '')" filename="sh_hr_application_name"/>
                            <field name="sh_hr_application_name" invisible="1"/>
                            <field name="sh_hr_last_day" required="not parent_id and ',sh_hr_last_day,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_legal_entity_id" options="{'no_create': True}" required="not parent_id and ',sh_hr_legal_entity_id,' in (sh_hr_required_fnames or '')"/>
                        </group>
                        <group>
                            <field name="sh_hr_reason" required="not parent_id and ',sh_hr_reason,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_special" required="not parent_id and ',sh_hr_special,' in (sh_hr_required_fnames or '')"/>
                            <field name="sh_hr_property" required="not parent_id and ',sh_hr_property,' in (sh_hr_required_fnames or '')"/>
                        </group>

                    </group>
                    <group invisible="sh_hr_state not in ('new', 'director')">
                        <field name="sh_hr_skip_rule_ids" widget="many2many_tags" options="{'no_create': True}"
                               domain="[('kind', '=', sh_hr_kind), ('optional', '=', True)]"
                               placeholder="ყველა ქვედავალება შეიქმნება (პარამეტრების მიხედვით)"/>
                    </group>
                    <div invisible="not sh_hr_subtask_ids" class="mt-2">
                        <div class="o_horizontal_separator mb-2">ქვედავალებები (დამტკიცების შემდეგ)</div>
                        <field name="sh_hr_subtask_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0" open_form_view="True">
                                <field name="sh_number" string="№"/>
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_avatar_user"/>
                                <field name="stage_id"/>
                                <field name="date_deadline"/>
                            </list>
                        </field>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_search_sh_hr_process" model="ir.ui.view">
        <field name="name">project.task.search.sh.hr.process</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="sh_hr_director" string="დირექტორთან" domain="[('sh_hr_state', '=', 'director')]"/>
                <filter name="sh_hr_open" string="ღია (კადრები)" domain="[('sh_hr_state', 'not in', ('done', 'refused'))]"/>
                <filter name="sh_hr_group_kind" string="პროცესი" context="{'group_by': 'sh_hr_kind'}"/>
                <filter name="sh_hr_group_state" string="პროცესის სტატუსი" context="{'group_by': 'sh_hr_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- the board: requests by process status. No "ახალი" / column "+" here: it made a plain (non-HR) task;
         a request is made from the menu „ახალი მოთხოვნა“ (one item per process). -->
    <record id="view_project_task_kanban_sh_hr_board" model="ir.ui.view">
        <field name="name">project.task.kanban.sh.hr.board</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="quick_create">0</attribute>
                <attribute name="group_create">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_project_task_list_sh_hr_board" model="ir.ui.view">
        <field name="name">project.task.list.sh.hr.board</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_sh_hr_board" model="ir.actions.act_window">
        <field name="name">კადრების მოთხოვნები</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('sh_hr_kind', '!=', False), ('parent_id', '=', False)]</field>
        <field name="context">{'group_by': 'sh_hr_state'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_project_task_kanban_sh_hr_board')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_project_task_list_sh_hr_board')})]"/>
    </record>

    <record id="action_sh_hr_new_vacancy" model="ir.actions.act_window">
        <field name="name">ვაკანსიის განთავსება</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_sh_hr_kind': 'vacancy', 'default_name': 'ვაკანსიის განთავსება'}</field>
    </record>
    <record id="action_sh_hr_new_hire" model="ir.actions.act_window">
        <field name="name">ახალი თანამშრომლის აყვანა</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_sh_hr_kind': 'hire', 'default_name': 'ახალი თანამშრომლის აყვანა'}</field>
    </record>
    <record id="action_sh_hr_new_dismissal" model="ir.actions.act_window">
        <field name="name">თანამშრომლის გათავისუფლება</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_sh_hr_kind': 'dismissal', 'default_name': 'თანამშრომლის გათავისუფლება'}</field>
    </record>

    <menuitem id="menu_sh_hr_root" name="კადრები" sequence="72"
              web_icon="steelhouse_hr_tasks,static/description/icon.svg"/>
    <menuitem id="menu_sh_hr_board" name="მოთხოვნები" parent="menu_sh_hr_root" action="action_sh_hr_board" sequence="1"/>
    <menuitem id="menu_sh_hr_new" name="ახალი მოთხოვნა" parent="menu_sh_hr_root" sequence="2"/>
    <menuitem id="menu_sh_hr_new_vacancy" name="ვაკანსიის განთავსება" parent="menu_sh_hr_new" action="action_sh_hr_new_vacancy" sequence="1"/>
    <menuitem id="menu_sh_hr_new_hire" name="ახალი თანამშრომლის აყვანა" parent="menu_sh_hr_new" action="action_sh_hr_new_hire" sequence="2"/>
    <menuitem id="menu_sh_hr_new_dismissal" name="თანამშრომლის გათავისუფლება" parent="menu_sh_hr_new" action="action_sh_hr_new_dismissal" sequence="3"/>
    <menuitem id="menu_sh_hr_config" name="პარამეტრები" parent="menu_sh_hr_root" action="action_sh_hr_task_config"
              sequence="9" groups="hr.group_hr_user"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_steelhouse_hr_task_config_form_sh_hr" model="ir.ui.view">
        <field name="name">steelhouse.hr.task.config.form</field>
        <field name="model">steelhouse.hr.task.config</field>
        <field name="arch" type="xml">
            <form string="კადრები - პარამეტრები" create="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1>კადრები - პარამეტრები</h1></div>
                    <field name="kind_id" invisible="1"/>
                    <!-- one line of tabs: „ადამიანები“ + the templates (added by _get_view) + „+“ -->
                    <div name="sh_kind_tabs" class="o_sh_kind_tabs">
                        <button name="action_sh_pick_kind" type="object" string="ადამიანები"
                                class="o_sh_kind_tab o_sh_kind_tab_on" invisible="kind_id"/>
                        <button name="action_sh_pick_kind" type="object" string="ადამიანები"
                                class="o_sh_kind_tab" invisible="not kind_id"/>
                        <button name="action_sh_new_kind" type="object" string="+ ახალი შაბლონი"
                                class="o_sh_kind_tab o_sh_kind_tab_new"/>
                    </div>
                    <div invisible="kind_id">
                        <group>
                            <field name="hr_manager_ids" widget="many2many_tags"/>
                            <field name="director_id"/>
                        </group>
                        <separator string="იურიდიული პირები (მოთხოვნაში ასარჩევი; „ორგანიზაციის კოდი“ აქედან ივსება)"/>
                        <field name="legal_entity_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </div>
                    <div invisible="not kind_id">
                        <group>
                            <field name="kind_required_field_ids" widget="many2many_tags"
                                   domain="[('kind_id', '=', kind_id)]" context="{'default_kind_id': kind_id}"
                                   options="{'no_quick_create': True}"/>
                        </group>
                        <separator string="ქვედავალებები - იქმნება დირექტორის დამტკიცების შემდეგ"/>
                        <field name="kind_subtask_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="assignee" column_invisible="1"/>
                                <field name="user_ids" widget="many2many_tags" string="ვის ეწერება"/>
                                <field name="optional"/>
                            </list>
                        </field>
                        <div class="mt-2">
                            <button name="action_sh_open_kind" type="object" string="სახელი / არქივი / წაშლა"
                                    class="btn-link p-0" icon="fa-pencil"/>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        „ვის ეწერება“ - ამ ადამიანებს ეწერება ქვედავალება დირექტორის დამტკიცებისას (ისინი მოთხოვნასაც ხედავენ).
                        „შეიძლება გამოტოვება“ - HR მოთხოვნაზე მონიშნავს „არ არის საჭირო“. ცვლილება მოქმედებს ახალ
                        დამტკიცებებზე.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- „შექმნა“ in the required-fields tags: a new field of the process (name + type) -->
    <!-- the list of the „ძიება“ window of the required-fields tags: a created field can be deleted from here -->
    <record id="view_steelhouse_hr_field_list_sh_hr" model="ir.ui.view">
        <field name="name">steelhouse.hr.field.list</field>
        <field name="model">steelhouse.hr.field</field>
        <field name="arch" type="xml">
            <list string="ველები">
                <field name="fname" column_invisible="1"/>
                <field name="name"/>
                <field name="ftype" string="ტიპი"/>
                <button name="action_sh_delete" type="object" icon="fa-trash-o" title="წაშლა" class="text-danger"
                        invisible="fname" confirm="ველი წაიშლება (ძველ მოთხოვნებზეც აღარ გამოჩნდება). გავაგრძელოთ?"/>
            </list>
        </field>
    </record>

    <record id="view_steelhouse_hr_field_form_sh_hr" model="ir.ui.view">
        <field name="name">steelhouse.hr.field.form</field>
        <field name="model">steelhouse.hr.field</field>
        <field name="arch" type="xml">
            <form string="ახალი ველი">
                <group>
                    <field name="kind_id" invisible="1"/>
                    <field name="fname" invisible="1"/>
                    <field name="name" placeholder="მაგ. გამოცდილების წლები"/>
                    <field name="ftype" readonly="fname"/>
                </group>
                <div class="text-muted small">ველი გამოჩნდება ამ პროცესის მოთხოვნის ფორმაზე; შენახვისას სავალდებულოდ მოინიშნება.</div>
            </form>
        </field>
    </record>

    <!-- a request template: the built-in ones and the ones HR creates (D-14) -->
    <record id="view_steelhouse_hr_kind_form_sh_hr" model="ir.ui.view">
        <field name="name">steelhouse.hr.kind.form</field>
        <field name="model">steelhouse.hr.kind</field>
        <field name="arch" type="xml">
            <form string="მოთხოვნის შაბლონი">
                <sheet>
                    <widget name="web_ribbon" title="დაარქივებული" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="kind" invisible="1"/>
                    <field name="is_builtin" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="შაბლონის სახელი"/>
                        <h1><field name="name" placeholder="მაგ. სტაჟიორის მიღება"/></h1>
                    </div>
                    <group>
                        <field name="required_field_ids" widget="many2many_tags" context="{'default_kind_id': id}"
                               options="{'no_quick_create': True}" placeholder="„+ ახალი ველი“ - ველის შექმნა"/>
                    </group>
                    <div class="text-muted small mb-3">
                        ველები გამოჩნდება ამ შაბლონის მოთხოვნის ფორმაზე. აქ მონიშნული ველი სავალდებულოა: მის გარეშე
                        მოთხოვნა არ შეინახება. „მეტის ძიება...“ - ყველა ველი (არასავალდებულოც), იქვე შექმნილის წაშლა.
                    </div>
                    <separator string="ქვედავალებები - იქმნება დირექტორის დამტკიცების შემდეგ"/>
                    <field name="subtask_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="assignee" column_invisible="1"/>
                            <field name="user_ids" widget="many2many_tags" string="ვის ეწერება"/>
                            <field name="optional"/>
                        </list>
                    </field>
                    <div class="text-muted small mt-2">
                        გზა ყველა შაბლონისთვის ერთია: ახალი → HR მენეჯერი („დირექტორს გაგზავნა“) → დირექტორი
                        (დამტკიცება / უარყოფა) → ქვედავალებები. შენახვისთანავე შაბლონი გამოჩნდება მენიუში
                        „ახალი მოთხოვნა“.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sh_hr_new_kind" model="ir.actions.act_window">
        <field name="name">ახალი შაბლონი</field>
        <field name="res_model">steelhouse.hr.kind</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_sh_hr_task_config" model="ir.actions.server">
        <field name="name">კადრები - პარამეტრები</field>
        <field name="model_id" ref="model_steelhouse_hr_task_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sh_open()</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Equal heads of one level are shown side by side. -->
    <t t-inherit="hr_org_chart.hr_org_chart" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='managers']" position="replace">
            <t t-foreach="managers" t-as="sh_level" t-key="sh_level_index">
                <t t-set="emp_count" t-value="emp_count + 1"/>
                <div class="o_sh_org_level" t-att-class="{ 'o_sh_org_level_multi': sh_level.co and sh_level.co.length }">
                    <t t-foreach="[sh_level].concat(sh_level.co or [])" t-as="employee" t-key="employee.id">
                        <t t-call="hr_org_chart.hr_org_chart_employee">
                            <t t-set="employee_type" t-value="'manager'"/>
                        </t>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>

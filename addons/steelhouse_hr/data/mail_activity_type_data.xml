<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- hr_holidays' approval types are noupdate records: set the flag with a function call -->
    <function model="mail.activity.type" name="write">
        <value eval="[ref('hr_holidays.mail_act_leave_approval'), ref('hr_holidays.mail_act_leave_second_approval')]"/>
        <value eval="{'sh_system_only': True}"/>
    </function>
</odoo>

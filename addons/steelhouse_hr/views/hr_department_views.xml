<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- All heads go in "ხელმძღვანელები"; Odoo's single manager_id is filled automatically and hidden. -->
    <record id="view_department_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.department.form.steelhouse</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <field name="manager_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="manager_id" position="after">
                <field name="manager_ids" widget="many2many_avatar_employee"/>
                <field name="sh_head_title"/>
                <field name="deputy_id" widget="many2one_avatar_employee"/>
            </field>
            <!-- new look (style only) -->
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_dept_form</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_department_tree_steelhouse" model="ir.ui.view">
        <field name="name">hr.department.list.steelhouse</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <field name="manager_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="manager_id" position="after">
                <field name="manager_ids" widget="many2many_avatar_employee"/>
                <field name="deputy_id" widget="many2one_avatar_employee" optional="show"/>
            </field>
            <!-- new look (style only): rows as cards, building badge, count pill, parent as a path of chips -->
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_dept_list</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
            <field name="total_employee" position="attributes">
                <attribute name="class">o_sh_count_cell</attribute>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="widget">sh_dept_path</attribute>
            </field>
        </field>
    </record>

    <!-- department cards: new look (style only); "no head" note when a unit has no head -->
    <record id="hr_department_view_kanban_steelhouse" model="ir.ui.view">
        <field name="name">hr.department.kanban.steelhouse</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.hr_department_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="class">o_hr_department_kanban o_kanban_small_column o_sh_dept_kanban</attribute>
            </xpath>
            <!-- all equal heads, each with photo and name (Odoo's card shows only the first one) -->
            <xpath expr="//t[@t-name='card']//field[@name='manager_id']" position="replace">
                <field name="manager_ids" widget="many2many_tags_avatar" readonly="1" class="o_sh_heads ms-2"/>
                <div t-if="!record.manager_ids.raw_value.length" class="o_sh_no_head ms-2">ხელმძღვანელი არ არის</div>
            </xpath>
            <xpath expr="//t[@t-name='card']//button[@name='action_employee_from_department']" position="attributes">
                <attribute name="class">btn btn-primary o_sh_emp_btn</attribute>
                <attribute name="t-att-class">{'o_sh_zero': !record.total_employee.raw_value}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_department_filter_steelhouse" model="ir.ui.view">
        <field name="name">hr.department.search.steelhouse</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_filter"/>
        <field name="arch" type="xml">
            <field name="manager_id" position="replace">
                <field name="manager_ids"/>
                <field name="deputy_id"/>
            </field>
        </field>
    </record>

    <!-- Configuration > Work locations: card rows with a type badge, type picker as a segmented control (style only) -->
    <record id="hr_work_location_tree_view_steelhouse" model="ir.ui.view">
        <field name="name">hr.work.location.list.steelhouse</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_workloc_list</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
        </field>
    </record>

    <!-- work location form: name on top next to a type badge, then address and type tiles (fields unchanged) -->
    <record id="hr_work_location_form_view_steelhouse" model="ir.ui.view">
        <field name="name">hr.work.location.form.steelhouse</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_workloc_form</attribute>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="o_sh_loc_head">
                    <div class="o_sh_loc_name">
                        <label for="name"/>
                        <field name="name"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//sheet/group//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Work schedules: card rows, rate as a bar, type as a pill (style only) -->
    <record id="view_resource_calendar_tree_steelhouse" model="ir.ui.view">
        <field name="name">resource.calendar.list.steelhouse</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_cal_list</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
            <field name="work_time_rate" position="attributes">
                <attribute name="widget">progressbar</attribute>
            </field>
            <field name="schedule_type" position="attributes">
                <attribute name="class">o_sh_pill_cell</attribute>
            </field>
        </field>
    </record>

    <!-- work schedule form: new look; schedule type side by side (fields unchanged) -->
    <record id="resource_calendar_form_steelhouse" model="ir.ui.view">
        <field name="name">resource.calendar.form.steelhouse</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_cal_form</attribute>
            </xpath>
            <field name="schedule_type" position="attributes">
                <attribute name="options">{'horizontal': true}</attribute>
            </field>
        </field>
    </record>

    <!-- Configuration > Departure reasons: card rows with an exit badge (style only) -->
    <record id="hr_departure_reason_view_list_steelhouse" model="ir.ui.view">
        <field name="name">hr.departure.reason.list.steelhouse</field>
        <field name="model">hr.departure.reason</field>
        <field name="inherit_id" ref="hr.hr_departure_reason_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_departure_list</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
        </field>
    </record>

    <!-- Configuration > Job positions: card rows; form in the new look (style only) -->
    <record id="view_hr_job_tree_steelhouse" model="ir.ui.view">
        <field name="name">hr.job.list.steelhouse</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_job_list</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
        </field>
    </record>
    <record id="view_hr_job_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.job.form.steelhouse</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_job_form</attribute>
            </xpath>
        </field>
    </record>
</odoo>

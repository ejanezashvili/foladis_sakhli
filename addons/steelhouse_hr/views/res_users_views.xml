<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Notifications: e-mail / Odoo / both (instead of Odoo's two-way choice) -->
    <record id="view_users_form_simple_modif_steelhouse" model="ir.ui.view">
        <field name="name">res.users.preferences.form.steelhouse</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="notification_type" position="after">
                <field name="sh_notification_channel" widget="radio" readonly="0"/>
            </field>
            <!-- new look of "My preferences" (style only) -->
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_prefs_form</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_steelhouse" model="ir.ui.view">
        <field name="name">res.users.form.steelhouse</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_mail"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="notification_type" position="after">
                <field name="sh_notification_channel" widget="radio" invisible="share"/>
            </field>
        </field>
    </record>

    <!-- "My activities" list: rows as cards, "linked to" in parts (style only) -->
    <record id="mail_activity_view_tree_steelhouse" model="ir.ui.view">
        <field name="name">mail.activity.list.steelhouse</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_activity_list</attribute>
            </xpath>
            <field name="activity_type_id" position="attributes">
                <attribute name="class">o_sh_act_type</attribute>
            </field>
            <field name="res_name" position="attributes">
                <attribute name="widget">sh_activity_link</attribute>
            </field>
        </field>
    </record>
</odoo>

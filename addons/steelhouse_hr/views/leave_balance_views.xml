<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="steelhouse_leave_balance_list" model="ir.ui.view">
        <field name="name">steelhouse.leave.balance.list</field>
        <field name="model">steelhouse.leave.balance</field>
        <field name="arch" type="xml">
            <list string="შვებულების ბალანსი" create="0" edit="0" delete="0" class="o_sh_balance_list o_sh_card_list">
                <field name="employee_id" widget="many2one_avatar_employee" column_invisible="context.get('sh_my_balance')"/>
                <field name="department_id" optional="hide"/>
                <field name="leave_type_id" class="fw-bold o_sh_type_cell"/>
                <field name="allocated" widget="float_without_trailing_zeros" invisible="not requires_allocation"/>
                <field name="used" widget="float_without_trailing_zeros" sum="სულ"/>
                <field name="pending" widget="float_without_trailing_zeros" decoration-warning="pending &gt; 0"/>
                <field name="remaining" widget="float_without_trailing_zeros" invisible="not requires_allocation" class="fw-bold o_sh_remaining"
                       decoration-danger="remaining &lt; 0" decoration-success="remaining &gt; 0"/>
                <field name="requires_allocation" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="steelhouse_leave_balance_search" model="ir.ui.view">
        <field name="name">steelhouse.leave.balance.search</field>
        <field name="model">steelhouse.leave.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="leave_type_id"/>
                <group>
                    <filter name="group_employee" string="თანამშრომელი" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="შვებულების ტიპი" context="{'group_by': 'leave_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- "My Time Off > Time off balance": every type with granted / used / pending / remaining days (this year) -->
    <record id="steelhouse_leave_balance_action_my" model="ir.actions.act_window">
        <field name="name">შვებულების ბალანსი</field>
        <field name="res_model">steelhouse.leave.balance</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'sh_my_balance': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">თქვენს ანგარიშს თანამშრომლის ბარათი არ აქვს მიბმული.</p>
        </field>
    </record>

    <record id="hr_holidays.menu_open_allocation" model="ir.ui.menu">
        <field name="action" ref="steelhouse_leave_balance_action_my"/>
    </record>

    <!-- HR: everyone's balance -->
    <record id="steelhouse_leave_balance_action_all" model="ir.actions.act_window">
        <field name="name">თანამშრომლების ბალანსი</field>
        <field name="res_model">steelhouse.leave.balance</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <menuitem id="menu_steelhouse_leave_balance_all" name="თანამშრომლების ბალანსი"
              parent="hr_holidays.menu_hr_holidays_management" action="steelhouse_leave_balance_action_all"
              groups="hr_holidays.group_hr_holidays_user" sequence="40"/>

    <!-- class for the new look of the days (allocation) request forms; fields unchanged -->
    <record id="hr_leave_allocation_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.allocation.form.steelhouse</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_hr_leave_allocation_form</attribute>
            </xpath>
            <!-- days as a whole number ("2", not "2,00") -->
            <xpath expr="//field[@name='number_of_days_display']" position="attributes">
                <attribute name="digits">[16, 0]</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_allocation_view_form_dashboard_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.allocation.form.dashboard.steelhouse</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_hr_leave_allocation_form</attribute>
            </xpath>
            <!-- days as a whole number ("2", not "2,00") -->
            <xpath expr="//field[@name='number_of_days_display']" position="attributes">
                <attribute name="digits">[16, 0]</attribute>
            </xpath>
            <!-- request from the calendar card: only types employees may ask days for (compensatory days) -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="domain">[('employee_requests', '=', True), ('requires_allocation', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- group allocation (Management > Allocations): same look as the days request form; fields unchanged -->
    <record id="hr_leave_allocation_generate_multi_wizard_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.allocation.generate.multi.wizard.form.steelhouse</field>
        <field name="model">hr.leave.allocation.generate.multi.wizard</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_generate_multi_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_hr_leave_allocation_form o_sh_group_allocation</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Time Off Types: card-style rows; approval as a blue pill (style only) -->
    <record id="view_holiday_status_normal_tree_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.type.list.steelhouse</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </xpath>
            <xpath expr="//field[@name='allocation_validation_type']" position="attributes">
                <attribute name="class">o_sh_pill_blue</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Time Off Types > form: class for the new look (fields unchanged) -->
    <record id="edit_holiday_status_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.type.form.steelhouse</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_type_form</attribute>
            </xpath>
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="class">o_sh_name_label</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Mandatory working days: card-style rows (style only) -->
    <record id="hr_leave_mandatory_day_view_list_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.mandatory.day.list.steelhouse</field>
        <field name="model">hr.leave.mandatory.day</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_mandatory_day_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_mandatory_list</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="class">o_sh_date_orange</attribute>
            </xpath>
            <xpath expr="//field[@name='end_date']" position="attributes">
                <attribute name="class">o_sh_date_orange o_sh_date_arrow</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Public holidays: card-style rows in green (style only) -->
    <record id="resource_calendar_leaves_tree_inherit_steelhouse" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.steelhouse</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_holiday_list</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </xpath>
            <xpath expr="//field[@name='date_from']" position="attributes">
                <attribute name="class">o_sh_date_green</attribute>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="class">o_sh_date_green o_sh_date_arrow</attribute>
            </xpath>
            <xpath expr="//field[@name='calendar_id']" position="attributes">
                <attribute name="class">o_sh_schedule_pill</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Accrual plans > level dialog: class for the new look (fields unchanged) -->
    <record id="hr_accrual_level_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.accrual.level.form.steelhouse</field>
        <field name="model">hr.leave.accrual.level</field>
        <field name="inherit_id" ref="hr_holidays.hr_accrual_level_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_sh_accrual_level</attribute>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Accrual plans: card rows, unnamed plans greyed, levels as a pill (style only) -->
    <record id="hr_accrual_plan_view_tree_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.list.steelhouse</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="inherit_id" ref="hr_holidays.hr_accrual_plan_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_sh_card_list o_sh_accrual_list</attribute>
                <attribute name="decoration-muted">name == 'უსახელო გეგმა'</attribute>
                <attribute name="decoration-it">name == 'უსახელო გეგმა'</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="class">fw-bold o_sh_type_cell</attribute>
            </field>
            <field name="level_count" position="attributes">
                <attribute name="class">o_sh_levels_cell</attribute>
                <attribute name="decoration-muted">level_count == 0</attribute>
            </field>
        </field>
    </record>
    <record id="hr_accrual_plan_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.form.steelhouse</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="inherit_id" ref="hr_holidays.hr_accrual_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_accrual_plan_form o_sh_accrual_plan_form</attribute>
            </xpath>
        </field>
    </record>

    <!-- approval / allocation cards: balance "24 / 24", not "24,00 / 24,00" -->
    <record id="hr_leave_view_kanban_days_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.kanban.days.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='virtual_remaining_leaves'][@widget='float']" position="attributes">
                <attribute name="widget">float_without_trailing_zeros</attribute>
            </xpath>
            <xpath expr="//field[@name='max_leaves'][@widget='float']" position="attributes">
                <attribute name="widget">float_without_trailing_zeros</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_allocation_view_kanban_days_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.allocation.kanban.days.steelhouse</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='virtual_remaining_leaves'][@widget='float']" position="attributes">
                <attribute name="widget">float_without_trailing_zeros</attribute>
            </xpath>
            <xpath expr="//field[@name='max_leaves'][@widget='float']" position="attributes">
                <attribute name="widget">float_without_trailing_zeros</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- mandatory working days repeating every month (models/mandatory_day_monthly.py) -->
    <record id="hr_leave_mandatory_day_view_form_sh_monthly" model="ir.ui.view">
        <field name="name">hr.leave.mandatory.day.form.sh.monthly</field>
        <field name="model">hr.leave.mandatory.day</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_mandatory_day_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_date']" position="after">
                <field name="sh_repeat_monthly" invisible="sh_template_id"/>
                <field name="sh_template_id" invisible="not sh_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_mandatory_day_view_list_sh_monthly" model="ir.ui.view">
        <field name="name">hr.leave.mandatory.day.list.sh.monthly</field>
        <field name="model">hr.leave.mandatory.day</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_mandatory_day_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_date']" position="after">
                <field name="sh_template_id" column_invisible="1"/>
                <field name="sh_repeat_monthly" readonly="sh_template_id" invisible="sh_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_mandatory_day_view_search_sh_monthly" model="ir.ui.view">
        <field name="name">hr.leave.mandatory.day.search.sh.monthly</field>
        <field name="model">hr.leave.mandatory.day</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_mandatory_day_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_date']" position="after">
                <filter name="sh_repeating" string="ყოველთვიური" domain="['|', ('sh_repeat_monthly', '=', True), ('sh_template_id', '!=', False)]"/>
                <filter name="sh_upcoming" string="მომავალი" domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>

    <record id="cron_mandatory_days_monthly" model="ir.cron">
        <field name="name">შვებულება: ყოველთვიური სავალდებულო დღეები</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_mandatory_day"/>
        <field name="state">code</field>
        <field name="code">model._sh_generate_monthly()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.form.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supported_attachment_ids']/.." position="after">
                <field name="department_id" invisible="1"/>
                <separator string="შემცვლელები"/>
                <field name="delegation_ids" nolabel="1" colspan="2"
                       readonly="state in ['cancel', 'refuse']"
                       context="{'default_department_id': department_id}">
                    <list editable="bottom" no_open="1">
                        <field name="department_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="deputy_id" widget="many2one_avatar_employee" options="{'no_create': True}"
                               placeholder="აირჩიეთ თანამშრომელი"
                               domain="[('id', '!=', parent.employee_id), ('department_id', 'child_of', department_id)]"
                               readonly="not department_id"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- "New time off" dialog of the dashboard: Odoo shows the employee read-only there;
         it can be chosen while the request is not decided yet -->
    <record id="hr_leave_view_form_dashboard_new_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.form.dashboard.new.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_dashboard_new_time_off"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@widget='many2one_avatar_employee']" position="attributes">
                <attribute name="readonly">state in ['validate', 'validate1', 'refuse', 'cancel']</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>

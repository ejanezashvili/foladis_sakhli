<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.form.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supported_attachment_ids']/.." position="after">
                <field name="department_id" invisible="1"/>
                <separator string="შემცვლელები"/>
                <field name="delegation_ids" nolabel="1" colspan="2"
                       readonly="state in ['cancel', 'refuse']"
                       context="{'default_department_id': department_id}">
                    <list editable="bottom" no_open="1">
                        <field name="department_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="deputy_id" widget="many2one_avatar_employee" options="{'no_create': True}"
                               placeholder="დეპარტამენტის თანამშრომლები ან ნებისმიერი სახელი"
                               domain="[('id', '!=', parent.employee_id)]"
                               context="{'sh_search_department': True, 'sh_deputy_department_id': department_id}"/>
                    </list>
                </field>
            </xpath>
            <!-- only the request itself: the employee's approved time off is in "My Time Off";
                 the request uses the full width (deputies table readable) -->
            <xpath expr="//div[hasclass('col_right')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('col_left')]" position="attributes">
                <attribute name="class">o_hr_leave_column col_left col-12</attribute>
            </xpath>
        </field>
    </record>

    <!-- "New time off" dialog of the dashboard: Odoo shows the employee read-only there;
         it can be chosen while the request is not decided yet -->
    <record id="hr_leave_view_form_dashboard_new_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.form.dashboard.new.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_dashboard_new_time_off"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@widget='many2one_avatar_employee']" position="attributes">
                <attribute name="readonly">state in ['validate', 'validate1', 'refuse', 'cancel']</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Overview: "My Team" = me and everyone under me, for every equal head (Odoo: only the first head's direct reports) -->
    <record id="hr_leave_report_calendar_view_search_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.search.steelhouse</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view_search"/>
        <field name="arch" type="xml">
            <filter name="my_team" position="attributes">
                <attribute name="domain">['|', ('employee_id.user_id', '=', uid), ('employee_id.sh_under_me', '=', True)]</attribute>
            </filter>
        </field>
    </record>

    <!-- "Waiting For Me" for heads = exactly what the dashboard card counts: requests at the head's step
         where I am the approver or one of the equal heads (also without the "Time Off Responsible" right) -->
    <record id="hr_leave_view_search_steelhouse" model="ir.ui.view">
        <field name="name">hr.leave.search.steelhouse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <filter name="waiting_for_me" position="attributes">
                <attribute name="domain">[('state', '=', 'confirm'), ('validation_type', '!=', 'hr'), ('employee_id.user_id', '!=', uid), '|', ('employee_id.leave_manager_id', '=', uid), ('employee_id.sh_head_user_ids', 'in', [uid])]</attribute>
                <attribute name="groups">base.group_user,!hr_holidays.group_hr_holidays_user</attribute>
            </filter>
        </field>
    </record>
</odoo>

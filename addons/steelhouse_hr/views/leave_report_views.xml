<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- which column of the month cut a time off type goes to -->
    <record id="edit_holiday_status_form_sh_report" model="ir.ui.view">
        <field name="name">hr.leave.type.form.sh.report</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_requests']" position="after">
                <field name="sh_report_kind"/>
            </xpath>
        </field>
    </record>

    <!-- the report page (static/src/leave_report) -->
    <record id="action_sh_leave_report" model="ir.actions.client">
        <field name="name">შვებულების რეპორტი</field>
        <field name="tag">sh_leave_report</field>
        <field name="path">sh-leave-report</field>
    </record>

    <menuitem id="menu_sh_leave_report" name="შვებულების რეპორტი"
              parent="hr_holidays.menu_hr_holidays_report" action="action_sh_leave_report"
              groups="hr_holidays.group_hr_holidays_user" sequence="1"/>

    <!-- PDF: exactly what the page shows -->
    <record id="action_report_sh_leave" model="ir.actions.report">
        <field name="name">შვებულების რეპორტი</field>
        <field name="model">hr.leave</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">steelhouse_hr.report_sh_leave</field>
        <field name="report_file">steelhouse_hr.report_sh_leave</field>
        <field name="print_report_name">'შვებულების რეპორტი'</field>
        <field name="paperformat_id" ref="steelhouse_hr.paperformat_sh_landscape"/>
    </record>

    <template id="report_sh_leave">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page" style="font-size: 9px;">
                    <h5 style="margin-bottom: 2px;">შვებულების რეპორტი - <t t-esc="d['view_label']"/></h5>
                    <p style="color: #7a7790; margin-bottom: 8px;"><t t-esc="d['period']"/> · <t t-esc="d['filter_label']"/></p>
                    <table style="margin-bottom: 10px;">
                        <tr>
                            <td style="padding: 4px 14px 4px 0;"><b style="font-size: 13px;" t-esc="num(d['kpi']['days']) or '0'"/> დღე სულ (დამტკიცებული)</td>
                            <td style="padding: 4px 14px;"><b style="font-size: 13px;" t-esc="num(d['kpi']['paid']) or '0'"/> ანაზღაურებადი</td>
                            <td style="padding: 4px 14px;"><b style="font-size: 13px;" t-esc="num(d['kpi']['unpaid']) or '0'"/> ანაზღაურების გარეშე</td>
                            <td style="padding: 4px 14px;"><b style="font-size: 13px;" t-esc="d['kpi']['employees']"/> თანამშრომელი</td>
                            <td style="padding: 4px 14px;"><b style="font-size: 13px;" t-esc="d['kpi']['requests']"/> მოთხოვნა</td>
                        </tr>
                    </table>
                    <t t-set="emp" t-value="d['params']['group'] == 'employee'"/>
                    <table class="table table-sm table-bordered" style="font-size: 8px;">
                        <thead>
                            <t t-if="d['groups']">
                                <tr>
                                    <th rowspan="2" t-esc="d['group_label']"/>
                                    <th t-if="emp" rowspan="2">დეპარტამენტი</th>
                                    <th t-foreach="d['groups']" t-as="g" t-att-colspan="g['span']" class="text-center" t-esc="g['label']"/>
                                    <th rowspan="2" class="text-center">სულ</th>
                                </tr>
                                <tr><th t-foreach="d['columns']" t-as="c" class="text-center" t-esc="c['label']"/></tr>
                            </t>
                            <tr t-else="">
                                <th t-esc="d['group_label']"/>
                                <th t-if="emp">დეპარტამენტი</th>
                                <th t-foreach="d['columns']" t-as="c" class="text-center" t-esc="c['label']"/>
                                <th class="text-center">სულ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d['rows']" t-as="r">
                                <td t-esc="r['label']"/>
                                <td t-if="emp" t-esc="r['sub']"/>
                                <td t-foreach="d['columns']" t-as="c" class="text-end" t-esc="num(r['values'].get(c['key']))"/>
                                <td class="text-end"><b t-esc="num(r['total'])"/></td>
                            </tr>
                            <tr t-if="not d['rows']"><td t-att-colspan="3 + len(d['columns'])">ამ პერიოდში შვებულება არ არის.</td></tr>
                            <tr t-if="d['rows']" style="font-weight: bold; background: #f6f4fb;">
                                <td t-att-colspan="2 if emp else 1">სულ</td>
                                <td t-foreach="d['columns']" t-as="c" class="text-end" t-esc="num(d['totals'].get(c['key']))"/>
                                <td class="text-end" t-esc="num(d['total'])"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>

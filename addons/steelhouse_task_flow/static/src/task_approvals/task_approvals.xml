<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="steelhouse_task_flow.TaskApprovals">
        <div class="o_action o_sh_ap">
            <div class="o_sh_ap_tabs">
                <t t-foreach="TABS" t-as="tb" t-key="tb.key">
                    <button t-att-class="'o_sh_ap_tab' + (state.tab === tb.key ? ' active' : '')" t-on-click="() => this.setTab(tb.key)">
                        <t t-esc="tb.label"/><span t-if="count(tb.key) !== null" class="o_sh_ap_badge" t-esc="count(tb.key)"/>
                    </button>
                </t>
                <input class="o_sh_ap_search form-control" type="text" placeholder="ძებნა..." t-att-value="state.search" t-on-input="onSearch"/>
            </div>

            <div class="o_sh_ap_body" t-att-class="{'o_sh_ap_loading': state.loading}">
                <t t-if="state.data">
                    <!-- ============ waiting for my decision ============ -->
                    <t t-if="state.tab === 'todo'">
                        <div class="o_sh_ap_sub">დავალებები, რომლებიც შემსრულებელმა შემოწმებაზე გადმოგიგზავნათ და თქვენს გადაწყვეტილებას ელოდება.</div>
                        <div t-if="state.data.stats" class="o_sh_ap_stats">
                            <div class="o_sh_ap_stat"><small>სულ ელოდება</small><b t-esc="state.data.stats.total"/></div>
                            <div class="o_sh_ap_stat o_sh_ap_s_late"><small>2 დღე ან მეტია ელოდება</small><b t-esc="state.data.stats.late"/></div>
                            <div class="o_sh_ap_stat o_sh_ap_s_due"><small>ვადა უკვე გასულია</small><b t-esc="state.data.stats.overdue"/></div>
                            <div class="o_sh_ap_stat o_sh_ap_s_again"><small>ადრე დაბრუნებული იყო</small><b t-esc="state.data.stats.again"/></div>
                        </div>
                    </t>
                    <div t-elif="state.tab === 'sent'" class="o_sh_ap_sub">თქვენი შესრულებული დავალებები, რომლებიც შემმოწმებლის გადაწყვეტილებას ელოდება.</div>
                    <div t-else="" class="o_sh_ap_sub">თქვენი ბოლო გადაწყვეტილებები: რა დაადასტურეთ და რა უარყავით.</div>

                    <!-- ============ cards ============ -->
                    <t t-if="state.tab !== 'history'">
                        <div t-if="!items.length" class="o_sh_ap_empty">
                            <i class="fa fa-check-circle"/>
                            <t t-if="state.search">ძებნით არაფერი მოიძებნა.</t>
                            <t t-elif="state.tab === 'todo'">დასადასტურებელი არაფერი გაქვთ.</t>
                            <t t-else="">შემოწმებაზე გაგზავნილი დავალება არ გაქვთ.</t>
                        </div>
                        <t t-foreach="items" t-as="it" t-key="it.id">
                            <div class="o_sh_ap_card">
                                <div class="o_sh_ap_ico"><i class="fa fa-clipboard"/></div>
                                <div class="o_sh_ap_main" t-on-click="() => this.openTask(it.id)">
                                    <div class="o_sh_ap_kind">დავალება შემოწმებაზე
                                        <span t-att-class="'o_sh_ap_wait' + (it.late ? ' o_sh_ap_wait_late' : '')">ელოდება <t t-esc="it.wait"/></span>
                                        <span t-if="it.returns" class="o_sh_ap_wait o_sh_ap_wait_again">↩ ადრე დაბრუნდა <t t-esc="it.returns"/>-ჯერ</span>
                                    </div>
                                    <div class="o_sh_ap_title"><t t-if="it.number"><t t-esc="it.number"/> </t><t t-esc="it.name"/></div>
                                    <div class="o_sh_ap_meta">
                                        <span>შეასრულა: <b t-esc="it.users"/></span>
                                        <span t-if="state.tab === 'sent'">ამოწმებს: <b t-esc="it.reviewers"/></span>
                                        <span>ვადა: <b t-att-class="it.overdue ? 'o_sh_ap_red' : ''" t-esc="it.deadline or 'არ აქვს'"/></span>
                                        <span>დეპარტამენტი: <b t-esc="it.department"/></span>
                                        <span t-if="it.project">პროექტი: <b t-esc="it.project"/></span>
                                        <span t-if="it.work_time">სამუშაო დრო: <b t-esc="it.work_time"/></span>
                                        <span t-if="it.files"><i class="fa fa-paperclip"/> <t t-esc="it.files"/> ფაილი</span>
                                        <span t-if="it.since">გამოგზავნილია: <t t-esc="it.since"/></span>
                                    </div>
                                </div>
                                <div class="o_sh_ap_btns">
                                    <button class="btn o_sh_ap_open" t-on-click="() => this.openTask(it.id)">გახსნა</button>
                                    <t t-if="state.tab === 'todo'">
                                        <button class="btn o_sh_ap_no" t-on-click="() => this.ask('no', it)">უარყოფა</button>
                                        <button class="btn o_sh_ap_ok" t-on-click="() => this.ask('ok', it)">დადასტურება</button>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>

                    <!-- ============ history ============ -->
                    <t t-else="">
                        <div t-if="!history.length" class="o_sh_ap_empty"><i class="fa fa-history"/>
                            <t t-if="state.search">ძებნით არაფერი მოიძებნა.</t><t t-else="">ჯერ არაფერი დაგიდასტურებიათ და არ უარგიყვიათ.</t>
                        </div>
                        <t t-foreach="history" t-as="h" t-key="h_index">
                            <div class="o_sh_ap_card o_sh_ap_hist" t-on-click="() => this.openTask(h.id)">
                                <div t-att-class="'o_sh_ap_ico ' + (h.kind === 'ok' ? 'o_sh_ap_ico_ok' : 'o_sh_ap_ico_no')">
                                    <i t-att-class="'fa ' + (h.kind === 'ok' ? 'fa-check' : 'fa-undo')"/></div>
                                <div class="o_sh_ap_main">
                                    <div t-att-class="'o_sh_ap_kind ' + (h.kind === 'ok' ? 'o_sh_ap_green' : 'o_sh_ap_red')">
                                        <t t-if="h.kind === 'ok'">დადასტურებულია</t><t t-else="">უარყოფილია</t>
                                        <span class="o_sh_ap_wait" t-esc="h.date"/>
                                    </div>
                                    <div class="o_sh_ap_title"><t t-if="h.number"><t t-esc="h.number"/> </t><t t-esc="h.name"/></div>
                                    <div class="o_sh_ap_meta">
                                        <span>შეასრულა: <b t-esc="h.users"/></span>
                                        <span t-if="h.kind === 'no'">მიზეზი: <b t-esc="h.reason or 'მითითებული არ არის'"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </div>

            <!-- ============ confirm / reject window ============ -->
            <div t-if="state.dialog" class="o_sh_ap_shade" t-on-click.self="closeDialog">
                <div t-att-class="'o_sh_ap_dlg ' + (state.dialog.mode === 'ok' ? 'o_sh_ap_dlg_ok' : 'o_sh_ap_dlg_no')">
                    <h3 t-if="state.dialog.mode === 'ok'">დადასტურება - დარწმუნებული ხართ?</h3>
                    <h3 t-else="">უარყოფა - მიუთითეთ მიზეზი</h3>
                    <div class="o_sh_ap_dlg_in">
                        <div class="o_sh_ap_what">
                            <b><t t-if="state.dialog.item.number"><t t-esc="state.dialog.item.number"/> </t><t t-esc="state.dialog.item.name"/></b>
                            <div>შეასრულა: <t t-esc="state.dialog.item.users"/></div>
                        </div>
                        <div t-if="state.dialog.mode === 'ok'" class="o_sh_ap_hint">დავალება დადასტურდება და გადავა დასრულებულში.</div>
                        <t t-else="">
                            <label>მიზეზი (სავალდებულო)</label>
                            <textarea class="form-control" rows="4" placeholder="რა არის გასასწორებელი?" t-att-value="state.dialog.reason" t-on-input="onReason"/>
                            <div t-if="state.dialog.error" class="o_sh_ap_err" t-esc="state.dialog.error"/>
                            <div class="o_sh_ap_hint">მიზეზს დაინახავს შემსრულებელი, დავალება დაუბრუნდება შესასწორებლად.</div>
                        </t>
                    </div>
                    <div class="o_sh_ap_dlg_foot">
                        <button class="btn o_sh_ap_open" t-att-disabled="state.dialog.busy" t-on-click="closeDialog">გაუქმება</button>
                        <button t-if="state.dialog.mode === 'ok'" class="btn o_sh_ap_ok" t-att-disabled="state.dialog.busy" t-on-click="confirm">კი, დადასტურდეს</button>
                        <button t-else="" class="btn o_sh_ap_rej" t-att-disabled="state.dialog.busy" t-on-click="confirm">უარყოფა</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

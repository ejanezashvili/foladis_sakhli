<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- fold icon on every open kanban column, next to "+" (folding no longer needs the column's menu);
         a folded column opens with its own arrows, as before -->
    <t t-inherit="web.KanbanHeader" t-inherit-mode="extension">
        <xpath expr="//GroupConfigMenu" position="after">
            <button t-if="!env.isSmall and !props.list.model.useSampleModel"
                    class="o_sh_column_fold btn px-1 d-print-none" t-on-click.stop="() => this.toggleGroup()">
                <i class="fa fa-compress opacity-75 opacity-100-hover" role="img" aria-label="ჩაკეცვა" title="ჩაკეცვა"/>
            </button>
        </xpath>
    </t>
</templates>

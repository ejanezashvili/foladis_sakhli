<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- the numbers above the columns -->
    <t t-name="steelhouse_task_flow.ConfBoardRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="inside">
            <div class="o_sh_conf_summary">
                <span class="o_sh_cs_total">სულ <b t-esc="summary.total"/></span>
                <span class="o_sh_cs_new">ახალი <b t-esc="summary.new"/></span>
                <span class="o_sh_cs_wip">მუშავდება <b t-esc="summary.wip"/></span>
                <span class="o_sh_cs_review">შემოწმებაზე <b t-esc="summary.review"/></span>
                <span class="o_sh_cs_late">ვადაგადაცილებული <b t-esc="summary.overdue"/></span>
            </div>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- the "+" card right after the last member -->
    <t t-name="steelhouse_task_flow.ConfKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_ghost')]" position="before">
            <div t-if="!props.list.isGrouped" class="o_kanban_record o_sh_conf_add" t-on-click="openAdd" title="თანამშრომლის დამატება">
                <span class="o_sh_conf_plus">+</span>
                <span class="o_sh_conf_add_label">თანამშრომლის დამატება</span>
            </div>
        </xpath>
    </t>

    <t t-name="steelhouse_task_flow.ConfAddDialog">
        <Dialog title="'თანამშრომლის დამატება - კონფიდენციალური'" size="'md'" footer="false">
            <input type="text" class="form-control mb-3" placeholder="ძიება სახელით, თანამდებობით ან დეპარტამენტით..."
                   t-att-value="state.term" t-on-input="onInput"/>
            <div class="o_sh_conf_list">
                <div t-foreach="state.items" t-as="item" t-key="item.id" class="o_sh_conf_row" t-on-click="() => this.add(item)">
                    <img t-att-src="avatar(item)" class="o_sh_conf_ava" alt=""/>
                    <div class="flex-grow-1">
                        <div class="o_sh_conf_name" t-esc="item.name"/>
                        <div class="o_sh_conf_job"><t t-esc="item.job"/><t t-if="item.job and item.department"> · </t><t t-esc="item.department"/></div>
                    </div>
                    <button type="button" class="btn btn-sm o_sh_conf_addbtn" t-att-disabled="state.busy">+ დამატება</button>
                </div>
                <div t-if="!state.items.length" class="text-muted p-2">ვერ მოიძებნა</div>
            </div>
        </Dialog>
    </t>
</templates>

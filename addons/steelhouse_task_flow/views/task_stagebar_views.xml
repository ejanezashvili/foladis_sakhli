<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- stage bar: done / returned / cancelled only for reviewers and administrators (models/task_stagebar.py) -->
    <record id="view_task_form_sh_stagebar" model="ir.ui.view">
        <field name="name">project.task.form.sh.stagebar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="domain">[('project_ids', '=', project_id), '|', ('id', '=', stage_id), ('sh_kind', 'not in', [] if sh_can_close else ['done', 'returned', 'cancelled'])]</attribute>
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <field name="sh_can_close" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>

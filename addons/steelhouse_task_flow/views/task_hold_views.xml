<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- task form: the previous task is on hold - optional "▶ გაგრძელება" (models/task_hold.py) -->
    <record id="view_task_form_sh_hold" model="ir.ui.view">
        <field name="name">project.task.form.sh.hold</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="steelhouse_task_flow.view_task_form_steelhouse_flow"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@name='warning_section']" position="after">
                <field name="sh_prev_held" invisible="1"/>
                <field name="sh_continue_ok" invisible="1"/>
                <div class="alert alert-warning mb-0 d-flex align-items-center gap-3" role="alert"
                     invisible="not sh_prev_held or sh_continue_ok or state in ('1_done', '1_canceled')">
                    <div class="flex-grow-1">
                        <i class="fa fa-pause me-1"/><b>წინა დავალება შეჩერებულია:</b>
                        <field name="sh_prev_held_info" readonly="1" class="d-inline"/>
                        <span> - შეგიძლია გააგრძელო შენი დავალება (სავალდებულო არ არის).</span>
                    </div>
                    <button name="action_sh_continue" type="object" string="▶ გაგრძელება" class="btn btn-success btn-sm"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- task card: the same strip with the button -->
    <record id="view_task_kanban_sh_hold" model="ir.ui.view">
        <field name="name">project.task.kanban.sh.hold</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="steelhouse_task_flow.view_task_kanban_steelhouse_flow"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='sh_card_lists']" position="before">
                <field name="sh_prev_held" invisible="1"/>
                <field name="sh_continue_ok" invisible="1"/>
                <div t-if="record.sh_prev_held.raw_value and !record.sh_continue_ok.raw_value and !['1_done', '1_canceled'].includes(record.state.raw_value)"
                     class="o_sh_held_strip">
                    <div><i class="fa fa-pause me-1"/>წინა დავალება შეჩერებულია</div>
                    <div class="o_sh_held_hint">შეგიძლია გააგრძელო შენი დავალება</div>
                    <button name="action_sh_continue" type="object" class="btn btn-success btn-sm mt-1">▶ გაგრძელება</button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- concrete project: hold / resume the whole project (not on departments) -->
    <record id="view_project_form_sh_hold" model="ir.ui.view">
        <field name="name">project.project.form.sh.hold</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sh_can_hold" invisible="1"/>
                <field name="sh_on_hold" invisible="1"/>
                <button name="action_sh_project_hold" type="object" string="⏸ პროექტის შეჩერება" class="btn-secondary"
                        invisible="not sh_can_hold or sh_on_hold"/>
                <button name="action_sh_project_resume" type="object" string="▶ პროექტის განახლება" class="btn-success"
                        invisible="not sh_can_hold or not sh_on_hold"
                        confirm="პროექტი განახლდეს? მასთან ერთად შეჩერებული დავალებები დაბრუნდება „ახალში“."/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not sh_on_hold">
                    <b>⏸ პროექტი შეჩერებულია</b>
                    <span invisible="not sh_hold_date"> · <field name="sh_hold_date" readonly="1" class="d-inline"/></span>
                    <span invisible="not sh_resume_date"> · განახლება: <field name="sh_resume_date" readonly="1" class="d-inline"/></span>
                    <div><field name="sh_hold_reason" readonly="1"/></div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_project_kanban_sh_hold" model="ir.ui.view">
        <field name="name">project.project.kanban.sh.hold</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//main[hasclass('o_project_kanban_main')]" position="inside">
                <field name="sh_on_hold" invisible="1"/>
                <div t-if="record.sh_on_hold.raw_value" class="o_sh_project_held"><i class="fa fa-pause me-1"/>შეჩერებულია</div>
            </xpath>
        </field>
    </record>

    <record id="view_sh_project_hold_wizard" model="ir.ui.view">
        <field name="name">steelhouse.project.hold.wizard.form</field>
        <field name="model">steelhouse.project.hold.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="project_id" invisible="1"/>
                <p class="text-muted">პროექტის ყველა ღია დავალება გადავა „შეჩერებულზე“. განახლებისას ისინი დაბრუნდება „ახალში“.</p>
                <group>
                    <field name="reason" placeholder="მოკლედ დაწერეთ მიზეზი"/>
                    <field name="resume_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="შეჩერება" class="btn-primary"/>
                    <button special="cancel" string="გაუქმება" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Timeline": tasks as bars up to their deadline (static/src/task_timeline). Access rules apply.
         It lives only in the "რეპორტინგი" app (no separate tab inside Projects). -->
    <record id="action_sh_task_timeline" model="ir.actions.client">
        <field name="name">Timeline და დატვირთვა</field>
        <field name="tag">sh_task_timeline</field>
        <field name="path">sh-timeline</field>
    </record>

    <!-- "რეპორტინგი" is its own app on the home screen (not a menu inside Projects): the standard
         reporting menu is lifted to the top level, so its children and access groups come along.
         It opens on its first child, "Timeline და დატვირთვა". -->
    <record id="project.menu_project_report" model="ir.ui.menu">
        <field name="name">რეპორტინგი</field>
        <field name="parent_id" eval="False"/>
        <field name="sequence">71</field>
        <field name="web_icon">steelhouse_task_flow,static/description/reporting_icon.svg</field>
    </record>
    <menuitem id="menu_sh_task_timeline_report" name="Timeline და დატვირთვა" parent="project.menu_project_report"
              action="action_sh_task_timeline" sequence="1"/>
</odoo>

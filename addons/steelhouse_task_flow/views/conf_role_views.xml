<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employees app, menu "კონფიდენციალური": the role's members as employee cards (models/task_conf_role.py) -->
    <record id="view_sh_conf_role_kanban" model="ir.ui.view">
        <field name="name">hr.employee.public.kanban.sh.conf</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_kanban"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="js_class">sh_conf_kanban</attribute>
                <attribute name="create">0</attribute>
                <attribute name="sample">0</attribute>
                <attribute name="class" add="o_sh_conf_kanban" separator=" "/>
            </kanban>
            <xpath expr="//t[@t-name='card']/main" position="inside">
                <button name="action_sh_conf_remove" type="object" class="o_sh_conf_x" title="კონფიდენციალურიდან ამოღება"
                        confirm="ამოვიღოთ კონფიდენციალურიდან? თანამშრომელი არ წაიშლება - უბრალოდ აღარ დაინახავს კონფიდენციალურ დავალებებს.">
                    <i class="fa fa-times"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_sh_conf_role" model="ir.actions.act_window">
        <field name="name">კონფიდენციალური</field>
        <field name="res_model">hr.employee.public</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_sh_conf_role_kanban"/>
        <field name="domain">[('sh_conf_member', '=', True)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- between "დეპარტამენტები" (10) and "კონფიგურაცია" (100); administrators only -->
    <menuitem id="menu_sh_conf_role" name="კონფიდენციალური" parent="hr.menu_hr_root" action="action_sh_conf_role"
              sequence="50" groups="project.group_project_manager,base.group_system"/>

    <function model="hr.employee.public" name="_sh_conf_init_members"/>
    <!-- who sees the confidential board (role + people on a confidential task) -->
    <function model="project.task" name="_sh_conf_sync_viewers"/>
</odoo>

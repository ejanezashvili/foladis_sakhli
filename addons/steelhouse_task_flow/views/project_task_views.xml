<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_steelhouse_flow" model="ir.ui.view">
        <field name="name">project.task.form.steelhouse.flow</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Task form layout: blocks "ვინ" / "როდის და სად დგას" / "დამატებით" -->
            <xpath expr="//sheet/group[group/field[@name='project_id']]" position="replace">
                <field name="active" invisible="1"/>
                <field name="allocated_hours" invisible="1"/>
                <div class="mb-2" invisible="not sh_number"><span class="o_sh_num_pill">№ <field name="sh_number" class="d-inline"/></span></div>
                <div class="d-flex align-items-center gap-2 mb-2" invisible="is_template" groups="project.group_project_manager">
                    <field name="sh_can_confidential" invisible="1"/>
                    <field name="sh_confidential" widget="boolean_toggle" nolabel="1" readonly="not sh_can_confidential"/>
                    <label for="sh_confidential" string="🔒 კონფიდენციალური" class="mb-0"/>
                    <span class="ms-auto o_sh_conf_note" invisible="not sh_confidential">
                        <i class="fa fa-lock me-1"/>ხედავენ მხოლოდ ადმინისტრატორები, მთავარი პასუხისმგებელი, შემსრულებლები, შემმოწმებლები, შემქმნელი და „დამატებით ხედავენ“
                    </span>
                </div>
                <!-- non-administrators see the extra viewers only when there are some -->
                <div class="d-flex align-items-center gap-2 mb-3 o_sh_conf_viewers"
                     invisible="not sh_confidential or is_template or (not sh_is_admin and not sh_confidential_viewer_ids)">
                    <label for="sh_confidential_viewer_ids" string="დამატებით ხედავენ" class="mb-0 text-nowrap"/>
                    <field name="sh_confidential_viewer_ids" widget="many2many_avatar_user" nolabel="1" options="{'no_create': True}"
                           readonly="not sh_can_confidential" class="flex-grow-1"/>
                </div>
                <separator string="ვინ"/>
                <group name="sh_who">
                    <group>
                        <!-- project_id is the department (gives the flow); "პროექტი" is the concrete project -->
                        <field name="project_id" string="დეპარტამენტი" widget="project"
                               domain="[('active', '=', True), ('sh_is_department', '=', True), '|', ('company_id', '=', False), ('company_id', '=?', company_id)]"
                               required="not is_template"/>
                        <field name="sh_project_id" options="{'no_create': True}" placeholder="არ ეკუთვნის პროექტს"/>
                        <field name="milestone_id" placeholder="e.g. Product Launch" context="{'default_project_id': project_id}"
                               invisible="not project_id or not allow_milestones"/>
                        <field name="partner_id" widget="res_partner_many2one" class="o_task_customer_field"
                               invisible="not project_id or has_template_ancestor or has_project_template"/>
                    </group>
                    <group>
                        <div colspan="2" class="d-flex justify-content-end" invisible="not id or is_template">
                            <widget name="sh_task_chat_button"/>
                        </div>
                        <field name="sh_responsible_id" widget="many2one_avatar_user" options="{'no_create': True}" invisible="is_template"/>
                        <field name="user_ids" class="o_task_user_field" options="{'no_open': True, 'no_quick_create': True}"
                               required="not project_id" widget="many2many_avatar_user"/>
                        <field name="role_ids" invisible="not has_project_template or is_template" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Assign at project creation"/>
                        <!-- set automatically (the creator of the task); only admins change it -->
                        <field name="reviewer_ids" widget="many2many_avatar_user" options="{'no_create': True, 'no_quick_create': True}" invisible="is_template"
                               readonly="not sh_is_admin"/>
                    </group>
                </group>
                <separator string="როდის და სად დგას"/>
                <group name="sh_when">
                    <group>
                        <field name="sh_create_datetime_str" invisible="not id"/>
                        <field name="sh_work_start"/>
                        <label for="date_deadline" string="დასრულების თარიღი"/>
                        <div id="date_deadline_and_recurring_task" class="d-inline-flex w-100">
                            <field name="date_deadline" nolabel="1" decoration-danger="date_deadline and date_deadline &lt; current_date and state not in ['1_done', '1_canceled']"/>
                            <field name="recurring_task" invisible="1"/>
                        </div>
                        <label for="repeat_interval" invisible="1"/>
                        <div invisible="1" class="d-flex" name="repeat_intervals">
                            <field name="repeat_interval" required="recurring_task" class="me-2" style="max-width: 2rem !important;"/>
                            <field name="repeat_unit" required="recurring_task" class="me-2" style="max-width: 4rem !important;"/>
                            <field name="repeat_type" required="recurring_task" class="me-2" style="max-width: 15rem !important;"/>
                            <field name="repeat_until" invisible="repeat_type != 'until'" required="repeat_type == 'until'" class="me-2"/>
                        </div>
                        <label for="sh_work_time" invisible="not sh_work_time"/>
                        <div invisible="not sh_work_time" class="o_sh_worktime">
                            <field name="sh_work_running" invisible="1"/>
                            <field name="sh_work_time" nolabel="1" class="fw-semibold" decoration-info="sh_work_running" decoration-success="not sh_work_running"/>
                            <div class="text-muted small"><field name="sh_work_time_note" nolabel="1"/></div>
                        </div>
                        <label for="sh_return_count" invisible="not sh_return_count"/>
                        <div invisible="not sh_return_count">
                            <span class="badge rounded-pill text-bg-danger me-2">↩ <field name="sh_return_count" class="d-inline"/>-ჯერ</span>
                            <span class="text-muted small"><field name="sh_return_note" nolabel="1"/></span>
                        </div>
                    </group>
                    <group>
                        <field name="evidence_required" invisible="1"/>
                        <field name="sh_repeat" invisible="is_template or parent_id"/>
                        <label for="sh_repeat_interval" invisible="not sh_repeat"/>
                        <div class="d-flex" invisible="not sh_repeat">
                            <field name="sh_repeat_interval" class="me-2" style="max-width: 3rem;" required="sh_repeat"/>
                            <field name="sh_repeat_unit" required="sh_repeat" style="max-width: 9rem;"/>
                        </div>
                        <field name="sh_repeat_start" invisible="not sh_repeat"/>
                        <field name="sh_repeat_next" invisible="not sh_repeat or not sh_repeat_next"/>
                        <label for="sh_repeat_until_type" invisible="not sh_repeat"/>
                        <div class="d-flex" invisible="not sh_repeat">
                            <field name="sh_repeat_until_type" class="me-2" style="max-width: 9rem;" required="sh_repeat"/>
                            <field name="sh_repeat_until" invisible="sh_repeat_until_type != 'until'"/>
                        </div>
                    </group>
                </group>
                <separator string="დამატებით"/>
                <group name="sh_more">
                    <group>
                        <field name="sh_category"/>
                        <field name="sh_branch"/>
                    </group>
                    <group>
                        <field name="tag_ids" invisible="1"/>
                    </group>
                </group>
            </xpath>
            <!-- task properties are replaced by the fields above -->
            <xpath expr="//field[@name='task_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- title row: progress left of the stars; the status button is hidden (the stage bar shows it) -->
            <xpath expr="(//field[@name='priority'])[1]" position="replace">
                <field name="sh_progress" widget="progressbar" nolabel="1" class="me-3" style="min-width: 160px;" invisible="is_template"/>
                <span class="fw-bold me-2">პრიორიტეტი</span>
                <field name="priority" widget="selection" class="o_sh_priority" style="min-width: 130px;"/>
                <button name="action_sh_save_template" type="object" icon="fa-floppy-o" class="btn btn-link fs-4 ms-2 p-0"
                        title="შაბლონად შენახვა" aria-label="შაბლონად შენახვა"
                        invisible="is_template or not id or not project_id"/>
            </xpath>
            <xpath expr="//div[hasclass('o_state_container')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- sub-tasks grouped by work stages (static/src/task_steps) -->
            <xpath expr="//page[@name='sub_tasks_page']/field[@name='child_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']" position="inside">
                <field name="sh_steps" widget="sh_task_steps" nolabel="1"/>
            </xpath>
            <!-- the client keeps only "თანმიმდევრობა": the sub-tasks tab is hidden -->
            <xpath expr="//page[@name='sub_tasks_page']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- "Blocked By" -> "თანმიმდევრობა": chain of tasks with arrows (static/src/task_chain) -->
            <xpath expr="//page[@name='task_dependencies']" position="attributes">
                <attribute name="string">თანმიმდევრობა</attribute>
            </xpath>
            <xpath expr="//page[@name='task_dependencies']/field[@name='depend_on_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='task_dependencies']" position="inside">
                <field name="sh_chain" widget="sh_task_chain" nolabel="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="sh_reasons" string="მიზეზები" invisible="sh_kind not in ('on_hold', 'returned', 'cancelled')">
                    <group>
                        <field name="hold_date" readonly="1" invisible="sh_kind != 'on_hold'"/>
                        <field name="hold_reason" placeholder="ჩაწერეთ შეჩერების მიზეზი..." invisible="sh_kind != 'on_hold'"/>
                        <field name="resume_date" invisible="sh_kind != 'on_hold'"/>
                        <field name="return_reason" placeholder="ჩაწერეთ დაბრუნების მიზეზი..." invisible="sh_kind != 'returned'"/>
                        <field name="cancel_reason" placeholder="ჩაწერეთ გაუქმების მიზეზი..." invisible="sh_kind != 'cancelled'"/>
                    </group>
                </page>
                <page name="sh_final" string="საბოლოო პროექტი" invisible="sh_kind not in ('review', 'done')">
                    <group>
                        <field name="sh_final_note" placeholder="რა გაკეთდა, შედეგი, შენიშვნები..."/>
                        <field name="sh_final_attachment_ids" widget="many2many_binary"/>
                        <field name="sh_done_user_id" invisible="not sh_done_user_id"/>
                        <field name="sh_done_date" invisible="not sh_done_date"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sh_open_templates" type="object" class="oe_stat_button" icon="fa-clipboard">
                    <div class="o_stat_info">
                        <span class="o_stat_text">შაბლონები</span>
                        <field name="sh_template_count" class="o_stat_value"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="sh_kind" invisible="1"/>
                <field name="sh_is_admin" invisible="1"/>
                <button name="action_sh_accept" type="object" string="✋ მიღება" class="btn-primary"
                        invisible="is_template or not project_id or uid not in user_ids or sh_kind != 'new' or state == '04_waiting_normal'"/>
                <button name="action_sh_review_ok" type="object" string="☐ შემოწმებულია" class="o_sh_btn_review"
                        confirm="დავალება დადასტურდება და გადავა დასრულებულში." confirm-title="დარწმუნებული ხარ?"
                        confirm-label="კი, დადასტურდეს" cancel-label="არა"
                        invisible="is_template or not project_id or sh_kind != 'review' or (uid not in reviewer_ids and not sh_is_admin)"/>
                <span class="badge text-bg-success fs-6 px-3 py-2" invisible="sh_kind != 'done'">✔ შემოწმებულია</span>
                <button name="action_sh_mark_done" type="object" string="✔ შესრულებულია" class="btn-success"
                        confirm="დავალება გადავა შემოწმებაზე." confirm-title="დარწმუნებული ხარ?"
                        confirm-label="კი, შესრულდა" cancel-label="არა"
                        invisible="is_template or not project_id or uid not in user_ids or sh_kind not in ('accepted', 'in_progress', 'returned') or state == '04_waiting_normal'"/>
            </xpath>
            <xpath expr="//t[@name='warning_section']" position="after">
                <div class="alert alert-secondary mb-0" role="alert" invisible="state != '04_waiting_normal' or not sh_waiting_for">
                    <i class="fa fa-lock me-1"/><b>ელოდება წინა დავალებებს:</b> <field name="sh_waiting_for" readonly="1" class="d-inline"/>
                    <span class="text-muted"> - აქტიური გახდება მათი შესრულების შემდეგ (ჩანართი „თანმიმდევრობა“).</span>
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="sh_kind != 'on_hold'">
                    <b>შეჩერებულია:</b> <field name="sh_hold_info" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="sh_kind != 'returned'">
                    <b>დაბრუნდა შესასწორებლად:</b> <field name="return_reason" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-secondary mb-0" role="alert" invisible="sh_kind != 'cancelled'">
                    <b>გაუქმებულია:</b> <field name="cancel_reason" readonly="1" class="d-inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_task_kanban_steelhouse_flow" model="ir.ui.view">
        <field name="name">project.task.kanban.steelhouse.flow</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <!-- Card in the "pill" style: status pill + number, title, department line, assignees,
                 deadline + priority, footer with comments / files / sub-tasks / activities / state -->
            <xpath expr="//t[@t-name='card']/main" position="replace">
                <main t-att-class="'o_sh_card' + (['1_done', '1_canceled'].includes(record.state.raw_value) ? ' o_sh_card_closed' : '') + (record.sh_step_badge.raw_value === 'wait' ? ' o_sh_card_waitstep' : '')">
                    <field name="sh_kind" invisible="1"/>
                    <field name="priority" invisible="1"/>
                    <field name="sh_deadline_str" invisible="1"/>
                    <field name="date_deadline" invisible="1"/>
                    <field name="sh_project_id" invisible="1"/>
                    <field name="sh_branch" invisible="1"/>
                    <field name="parent_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="sh_is_overdue" invisible="1"/>
                    <field name="sh_repeat" invisible="1"/>
                    <field name="closed_subtask_count" invisible="1"/>
                    <field name="sh_comment_count" invisible="1"/>
                    <field name="message_attachment_count" invisible="1"/>
                    <field name="project_id" invisible="1"/>
                    <field name="sh_progress" invisible="1"/>
                    <field name="sh_confidential" invisible="1"/>
                    <div class="o_sh_card_top">
                        <i t-if="record.sh_confidential.raw_value" class="fa fa-lock text-danger o_sh_card_lock" title="კონფიდენციალური"/>
                        <field name="name" class="o_sh_card_title"/>
                        <field name="sh_number" class="o_sh_card_num"/>
                    </div>
                    <div t-if="record.project_id.raw_value or record.parent_id.raw_value" class="o_sh_card_sub">
                        <i class="fa fa-building-o me-1" title="დეპარტამენტი"/>
                        <field t-if="record.parent_id.raw_value" invisible="context.get('default_parent_id', False)" name="parent_id"/>
                        <span t-if="!record.parent_id.raw_value" t-esc="record.project_id.value"/>
                        <t t-if="record.sh_project_id.raw_value"> · <field name="sh_project_id"/></t>
                    </div>
                    <div t-if="record.sh_branch.raw_value or record.sh_repeat.raw_value or record.state.raw_value === '04_waiting_normal'" class="o_sh_card_sub">
                        <t t-if="record.sh_branch.raw_value"><i class="fa fa-map-marker me-1" title="ფილიალი"/><field name="sh_branch"/></t>
                        <t t-if="record.sh_repeat.raw_value"><t t-if="record.sh_branch.raw_value"> · </t><i class="fa fa-repeat me-1"/>განმეორებადი</t>
                        <t t-if="record.state.raw_value === '04_waiting_normal'"> · <i class="fa fa-lock me-1" title="ელოდება წინა დავალებებს"/>ელოდება</t>
                    </div>
                    <div t-if="record.partner_id.raw_value" class="o_sh_card_sub"><i class="fa fa-user-o me-1" title="კლიენტი"/><field name="partner_id"/></div>
                    <!-- a sequence step shown to its performer: its place in the sequence and what it waits for -->
                    <field name="sh_step_badge" invisible="1"/>
                    <field name="sh_step_pos" invisible="1"/>
                    <field name="sh_step_info" invisible="1"/>
                    <div t-if="record.sh_step_badge.raw_value" t-att-class="'o_sh_step_badge o_sh_step_' + record.sh_step_badge.raw_value">
                        <div class="o_sh_step_head">
                            <i class="fa fa-link me-1"/>ნაბიჯი <t t-esc="record.sh_step_pos.raw_value"/> -
                            <t t-esc="record.sh_step_badge.value"/>
                        </div>
                        <div class="o_sh_step_line" t-esc="record.sh_step_info.raw_value"/>
                    </div>
                    <!-- sub-tasks / sequence: buttons, the list opens inside the card (static/src/card_lists) -->
                    <widget name="sh_card_lists"/>
                    <footer t-if="!selection_mode" class="o_sh_card_foot">
                        <span t-att-class="'o_sh_card_date' + (record.sh_is_overdue.raw_value ? ' text-danger fw-semibold o_sh_overdue_mark' : '')">
                            <i class="fa fa-flag-checkered me-1" title="ვადა"/>
                            <t t-if="record.sh_deadline_str.raw_value" t-esc="record.sh_deadline_str.raw_value"/>
                            <t t-if="!record.sh_deadline_str.raw_value">-</t>
                        </span>
                        <div class="ms-auto d-flex align-items-center gap-2">
                            <span t-if="record.priority.raw_value" t-att-class="'o_sh_prio o_sh_prio_' + record.priority.raw_value" t-esc="record.priority.value"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="state" widget="project_task_state_selection" options="{'is_toggle_mode': false}"/>
                        </div>
                    </footer>
                    <!-- stage path: ახალი → მიღებული → მიმდინარე → შემოწმებაზე → დასრულებული;
                         passed steps are coloured with their stage colour; on hold / returned colour the current step -->
                    <t t-set="sh_path" t-value="['new', 'accepted', 'in_progress', 'review', 'done']"/>
                    <t t-set="sh_k" t-value="record.sh_kind.raw_value or 'new'"/>
                    <t t-set="sh_pos" t-value="sh_k === 'on_hold' or sh_k === 'returned' ? 2 : (sh_k === 'cancelled' ? -1 : sh_path.indexOf(sh_k))"/>
                    <div t-att-class="'o_sh_seg o_sh_seg_' + sh_k" t-att-title="record.stage_id.value">
                        <t t-foreach="sh_path" t-as="step" t-key="step">
                            <i t-att-class="step_index &lt; sh_pos ? 'o_sh_seg_' + step : (step_index === sh_pos ? 'o_sh_seg_' + sh_k + ' o_sh_seg_cur' : '')"/>
                        </t>
                    </div>
                </main>
            </xpath>
        </field>
    </record>

    <record id="view_task_list_steelhouse_flow" model="ir.ui.view">
        <field name="name">project.task.list.steelhouse.flow</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="sh_progress" widget="progressbar" optional="show"/>
                <field name="sh_confidential" string="🔒" widget="boolean_icon" options="{'icon': 'fa-lock'}" optional="show" readonly="1"/>
                <field name="sh_is_overdue" column_invisible="1"/>
            </xpath>
            <xpath expr="/list" position="attributes">
                <attribute name="decoration-danger">sh_is_overdue</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_task_search_steelhouse_number" model="ir.ui.view">
        <field name="name">project.task.search.steelhouse.number</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[1]" position="before">
                <!-- typed text + Enter: task name, number, project or department - all at once -->
                <field name="name" string="ძიება (დავალება / ნომერი / პროექტი)"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('sh_number', 'ilike', self), ('sh_project_id.name', 'ilike', self), ('project_id.name', 'ilike', self)]"/>
                <field name="sh_number" string="ნომერი"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="sh_overdue" string="ვადაგადაცილებული" domain="[('sh_is_overdue', '=', True)]"/>
                <filter name="sh_main_only" string="მხოლოდ მთავარი დავალებები" domain="[('sh_is_step', '=', False)]"/>
                <filter name="sh_confidential" string="🔒 კონფიდენციალური" domain="[('sh_confidential', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>

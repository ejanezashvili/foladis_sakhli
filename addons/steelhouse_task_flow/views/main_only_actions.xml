<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence steps are seen only inside their main task's card ("⛓ თანმიმდევრობა"):
         the task menus open with the filter "მხოლოდ მთავარი დავალებები" on (it can be removed). -->
    <record id="project.action_view_my_task" model="ir.actions.act_window">
        <field name="context">{
            'search_default_open_tasks': 1,
            'my_tasks': 1,
            'default_user_ids': [(4, uid)],
        }</field>
        <!-- "ჩემი დავალებები": my own sequence steps are shown too (with the step badge) -->
        <!-- only where I am an assignee; the main responsible finds his tasks in "ყველა დავალება" -->
        <field name="domain">[('user_ids', 'in', uid), ('has_template_ancestor', '=', False), ('has_project_template', '=', False)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sh_repeat" model="ir.cron">
        <field name="name">დავალებები: განმეორება თარიღზე</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_sh_repeat()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_sh_overdue_notify" model="ir.cron">
        <field name="name">დავალებები: ვადაგადაცილება და ესკალაცია</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_sh_overdue_notify()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <!-- daily 09:00 Tbilisi (05:00 UTC); the digest itself goes out once a week, on its first working day -->
    <record id="ir_cron_sh_weekly_digest" model="ir.cron">
        <field name="name">დავალებები: კვირის შეჯამება</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_sh_weekly_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
        <field name="active" eval="True"/>
    </record>
    <!-- nightly 00:05 Tbilisi (20:05 UTC): "ჩემი დავალებები" columns by creation date -->
    <record id="ir_cron_sh_place_personal" model="ir.cron">
        <field name="name">დავალებები: „ჩემი დავალებების“ სვეტები შექმნის თარიღით</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_sh_place_personal()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d 20:05:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>

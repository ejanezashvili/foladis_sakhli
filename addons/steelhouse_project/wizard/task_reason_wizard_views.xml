<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_reason_wizard_form" model="ir.ui.view">
        <field name="name">steelhouse.task.reason.wizard.form</field>
        <field name="model">steelhouse.task.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="task_ids" invisible="1"/>
                <group>
                    <field name="mode"/>
                    <field name="reason" placeholder="მოკლედ დაწერეთ მიზეზი"/>
                    <field name="resume_date" invisible="mode != 'hold'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="დადასტურება" class="btn-primary"/>
                    <button special="cancel" string="გაუქმება" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

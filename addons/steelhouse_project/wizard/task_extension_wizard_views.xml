<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_extension_wizard_form" model="ir.ui.view">
        <field name="name">steelhouse.task.extension.wizard.form</field>
        <field name="model">steelhouse.task.extension.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="task_id" invisible="1"/>
                <group>
                    <field name="current_deadline" readonly="1"/>
                    <field name="new_deadline"/>
                    <field name="reason" placeholder="რატომ ვერ სრულდება დავალება ვადაში?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="მოთხოვნის გაგზავნა" class="btn-primary"/>
                    <button special="cancel" string="გაუქმება" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
